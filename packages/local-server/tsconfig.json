{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@dramaforge/shared": [
        "../shared/src"
      ],
      "@dramaforge/server": [
        "../server/src"
      ],
      "@server/*": ["../server/src/*"],
      "@shared/*": ["../shared/src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*"
  ]
}

{
  "name": "@dramaforge/client",
  "version": "1.4.4",
  "private": true,
  "description": "DramaForge Studio C/S desktop client (Electron + local ffmpeg)",
  "author": "DramaForge",
  "main": "dist-main/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./render-worker": "./src/render-worker/index.ts",
    "./ops/heartbeat": "./src/ops/heartbeat/index.ts",
    "./ops/logger": "./src/ops/logger/index.ts",
    "./ops/updater": "./src/ops/updater/index.ts",
    "./ffmpeg": "./src/ffmpeg/index.ts",
    "./orchestrators": "./src/orchestrators/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:main": "node scripts/build-main.mjs",
    "build": "pnpm run build:main && node scripts/protect.mjs",
    "package": "electron-builder",
    "dev": "electron .",
    "package:local": "electron-builder --config electron-builder.local.yml",
    "build:local": "pnpm --filter @dramaforge/web build:static && pnpm --filter @dramaforge/local-server build && pnpm run build:main && pnpm run package:local"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@dramaforge/shared": "workspace:*",
    "bytenode": "^1.6.0",
    "sharp": "^0.35.0"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/win32-x64": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

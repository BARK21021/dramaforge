# =============================================================================
# DramaForge — 部署环境变量模板
# =============================================================================
#
# 使用说明：
#   1. 本文件是模板，包含占位值，不含任何真实密钥。
#   2. 部署时复制为 .env （docker-compose.yml 通过 env_file 引用）：
#        cp .env.example .env
#      然后填入真实值。
#   3. 标注 [生产必改] 的字段必须在生产环境替换为强随机值。
#   4. .env 已被 .gitignore 忽略，切勿提交到 git。
#   5. AI 各 provider 的 key 从 app1 现有 .env 中取（app1 已配好生产 key）。
#
# 权威清单：packages/server/src/infra/env.ts (Zod schema)
# Compose 行为：docker-compose.yml
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# postgres:16-alpine 容器初始化用（首次启动创建 superuser + database）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production        # [生产必改] 强随机密码
POSTGRES_DB=dramaforge

# 应用层连接串（src/infra/env.ts 读取；compose 里会被 environment 覆盖为服务名）
DATABASE_URL=postgresql://postgres:change-me-in-production@localhost:5432/dramaforge
# 注意：docker-compose.yml 在 web/ai-worker/migrate 服务里用 environment 覆盖了
#       DATABASE_URL 指向 postgres 服务名，所以 compose 部署时此值被覆盖；
#       保留占位仅用于本地/裸机运行场景。


# -----------------------------------------------------------------------------
# Redis (BullMQ 队列 + Pub/Sub + 缓存)
# -----------------------------------------------------------------------------
# compose 里 REDIS_URL 会被覆盖为 redis://redis:6379
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# MinIO (对象存储 — 用户上传 / AI 产物 / 客户端日志)
# -----------------------------------------------------------------------------
# compose 里 MINIO_ENDPOINT 会被覆盖为 minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me-in-production         # [生产必改] 从 app1 .env 取
MINIO_SECRET_KEY=change-me-in-production         # [生产必改] 从 app1 .env 取
MINIO_BUCKET=dramaforge
MINIO_USE_SSL=false


# -----------------------------------------------------------------------------
# Auth (NextAuth.js)
# -----------------------------------------------------------------------------
# [生产必改] 生成强随机串：openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
# [生产必改] 改为实际对外可访问的域名，例如 https://your-domain.example.com
NEXTAUTH_URL=https://your-domain.example.com

# JWT 密钥（客户端 heartbeat / render-worker 鉴权备用）
# [生产必改] 生成：openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32


# -----------------------------------------------------------------------------
# AI Providers (从 app1 .env 中取生产 key)
# -----------------------------------------------------------------------------
# 各 provider 未配置时相关功能不可用，但不会阻止应用启动。
# key 存 DB system_configs 表 (getCredential 查询)，这里仅占位参考。
# 实际部署时从 app1 .env 复制对应值到 system_configs 或此处。

# DeepSeek（深度求索，文本生成主力）
DEEPSEEK_API_KEY=<从 app1 .env 取>
DEEPSEEK_BASE_URL=

# 火山引擎 Ark（多模态/视频）
ARK_API_KEY=<从 app1 .env 取>
ARK_BASE_URL=
VOLCENGINE_ACCESS_KEY=<从 app1 .env 取>
VOLCENGINE_SECRET_KEY=<从 app1 .env 取>

# FAL.ai（图像/视频生成）
FAL_API_KEY=<从 app1 .env 取>
FAL_BASE_URL=

# 其他可选 provider
OPENAI_API_KEY=<从 app1 .env 取>
OPENAI_BASE_URL=
GOOGLE_AI_API_KEY=<从 app1 .env 取>
GOOGLE_AI_BASE_URL=
MINIMAX_API_KEY=<从 app1 .env 取>
MINIMAX_BASE_URL=
VIDU_API_KEY=<从 app1 .env 取>
VIDU_BASE_URL=
SILICONFLOW_API_KEY=<从 app1 .env 取>
SILICONFLOW_BASE_URL=
KIMI_API_KEY=<从 app1 .env 取>
KIMI_BASE_URL=


# -----------------------------------------------------------------------------
# 客户端版本管控 (⑬ heartbeat 强制淘汰)
# -----------------------------------------------------------------------------
# 最低允许的客户端版本；低于此值的客户端被 force_upgrade 锁死
# 存 system_configs 表的 MIN_CLIENT_VERSION 字段，此处仅占位
MIN_CLIENT_VERSION=0.0.0

# 客户端版本清单 JSON URL（静默下载器 ⑭ 轮询此 manifest）
# 存 system_configs 表的 CLIENT_VERSIONS_MANIFEST 字段
CLIENT_VERSIONS_MANIFEST=https://your-domain.example.com/versions/manifest.json


# -----------------------------------------------------------------------------
# Web 端口
# -----------------------------------------------------------------------------
# docker-compose.yml web 服务的宿主端口映射
WEB_PORT=3000


# -----------------------------------------------------------------------------
# 镜像 tag (deploy.sh 用)
# -----------------------------------------------------------------------------
# docker-compose.yml 中 ${TAG:-latest} 引用；deploy.sh 传 git short sha
TAG=latest


# -----------------------------------------------------------------------------
# Local E2E harness (never point these at production)
# -----------------------------------------------------------------------------
E2E_API_BASE=http://localhost:3000
# Dedicated local database used by both the E2E harness and the web server under test.
# The database name must end in `_e2e`.
E2E_DATABASE_URL=postgresql://postgres:change-me-in-production@localhost:5432/dramaforge_e2e
# Dedicated MinIO bucket; the name must end in `-e2e`.
E2E_MINIO_BUCKET=dramaforge-e2e
# Required explicit opt-in because the harness writes temporary DB/MinIO data
# and briefly changes CLIENT_VERSIONS_MANIFEST before restoring it.
E2E_ALLOW_MUTATION=0


# -----------------------------------------------------------------------------
# 短信网关（阿里云 dysmsapi — 手机号注册验证码）
# -----------------------------------------------------------------------------
# 与 app1 同款 SDK：@alicloud/dysmsapi20170525。
# 全 optional：缺密钥时应用照常启动；SMS_MOCK_ENABLED=true 时走 mock
# 模式（不调阿里云，验证码按生成值存 Redis，开发联调用）；生产环境强制走真实短信。
#
# C3（修-C）：SMS_MOCK_ENABLED 是正向开关（默认不激活）。
#   - 历史实现用 `SMS_ENABLED=false && NODE_ENV !== 'production'` 负向判定，
#     NODE_ENV 写成 prod/staging 或漏配 → 误激活 mock → 任意 code 注册成功。
#   - 现要求显式 SMS_MOCK_ENABLED=true 才激活；且 NODE_ENV=production 下
#     env.ts 启动校验会直接 throw 阻止启动（即使误配也不生效）。
#
# GC-8：短信 key 只在云端服务器，不写入代码/git。部署时从 app1 .env 复制真值。
#
# SMS_ENABLED 仍保留作"网关总开关"（false 表示不发短信，但不自动激活 mock）
SMS_ENABLED=false                                # [生产必改] 改 true
# SMS mock 模式正向开关（C3）：仅本地/测试环境显式置 true 使用；生产绝不可
SMS_MOCK_ENABLED=false                           # [生产禁止] true 会导致任意验证码注册成功
SMS_CODE_TTL_SECONDS=60                          # 验证码有效期（秒，默认 60）
SMS_RESEND_LOCK_SECONDS=60                       # 重发锁定期（秒，默认 60）
SMS_CODE_MAX_ATTEMPTS=5                          # 验证码最大尝试次数（默认 5）
ALIYUN_SMS_ACCESS_KEY_ID=                        # [生产必填] RAM 子账号，仅授予 dysmsapi:SendSms 权限
ALIYUN_SMS_ACCESS_KEY_SECRET=                    # [生产必改]
ALIYUN_SMS_SIGN_NAME=                            # 控制台审核通过的签名
ALIYUN_SMS_TEMPLATE_CODE=                        # 如 SMS_xxxxxxxxx，模板须含 ${code} 变量
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# 新注册用户初始积分（默认 0，不赠送）
FREE_QUOTA_CREDITS=0
